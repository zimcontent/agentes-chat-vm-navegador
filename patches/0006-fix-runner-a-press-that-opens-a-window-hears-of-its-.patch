@@ -376,6 +398,16 @@ export function countChromeTraffic(
     const p = isObject(msg.params) ? msg.params : {};
     const sessionId = typeof msg.sessionId === "string" ? msg.sessionId : "";
     switch (msg.method) {
+      case "Target.targetCreated": {
